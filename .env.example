# Copy this file to .env. setup.sh / setup.ps1 do this for you and fill in a
# generated key. One URL-safe Base64-encoded 512-bit (64-byte) key.
# Keep the same key for the lifetime of the encrypted workbooks.
SECRET_KEY="paste_the_complete_generated_key_here"

# Leave this unset (or 0) for client deployments.
#
# When set to 1/true/yes/on, the web page shows a "Copy key" button and
# POST /secret-key returns SECRET_KEY to any browser that can open the app.
# The app has no login, so that hands the key which decrypts every workbook the
# app has produced to anyone who can reach the page. Only enable it on a
# machine that is not reachable by anyone else, and turn it off again when you
# are done. Prefer the setup scripts' Copy Key action, which writes the key to
# a local recovery file without ever sending it over HTTP.
# ENABLE_KEY_EXPOSURE=0
